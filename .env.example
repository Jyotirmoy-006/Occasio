# Occasio Environment Variables
# Copy this file to .env.local and fill in your values.
# The app runs in DEMO MODE (high-quality template fallback) if GEMINI_API_KEY is not set.

# Gemini API key — obtain from https://aistudio.google.com/
# NEVER commit your actual key. This file is safe to commit.
GEMINI_API_KEY=

# Rate limiting (optional overrides)
RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW_MS=60000

